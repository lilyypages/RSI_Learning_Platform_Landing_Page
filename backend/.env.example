# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql+psycopg2://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# --- Local fallback (optional) ---
POSTGRES_USER=sipanda
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sipanda
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
