generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique @db.VarChar(255)
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  role              String   @db.VarChar(20)
  name              String   @db.VarChar(255)
  username          String?  @unique @db.VarChar(100)
  imageUrl          String?  @map("image_url") @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  forcePasswordChange Boolean @default(false) @map("force_password_change")
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  creator   User?  @relation("UserCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreator")

  student    Student?
  teacher    Teacher?
  parent     Parent?
  principal  Principal?
  sentMessages     Message[]  @relation("SentMessage")
  receivedMessages Message[]  @relation("ReceivedMessage")
  notifications    Notification[]
  auditLogs        AuditLog[]
  passwordHistory  PasswordHistory[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  detail    String?  @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_history")
}

model Student {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  classId        String?  @map("class_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  nis            String   @unique @db.VarChar(50)
  birthdate      DateTime? @db.Date
  totalPoints    Int      @default(0) @map("total_points")
  currentStreak  Int      @default(0) @map("current_streak")
  livesRemaining Int      @default(3) @map("lives_remaining")

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  parent      Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)
  progress    StudentProgress[]
  quizSessions QuizSession[]
  videoWatches VideoWatch[]
  pointLogs   PointLog[]
  weeklyReports WeeklyReport[]

  @@map("students")
}

model Parent {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @unique @map("user_id") @db.Uuid
  phone   String? @db.VarChar(20)
  address String? @db.Text

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]

  @@map("parents")
}

model Teacher {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @unique @map("user_id") @db.Uuid
  nip    String? @unique @db.VarChar(50)
  phone  String? @db.VarChar(20)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeroomClasses Class[]      @relation("HomeroomTeacher")
  classSubjects  ClassSubject[]
  weeklyReports  WeeklyReport[]

  @@map("teachers")
}

model Principal {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  nip    String? @unique @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("principals")
}

model Class {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(50)
  gradeLevel        Int      @map("grade_level")
  homeroomTeacherId String?  @map("homeroom_teacher_id") @db.Uuid
  academicYear      Int      @map("academic_year")

  homeroomTeacher Teacher?      @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students        Student[]
  classSubjects   ClassSubject[]

  @@map("classes")
}

model Subject {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @db.VarChar(100)
  code    String  @unique @db.VarChar(50)
  iconUrl String? @map("icon_url") @db.VarChar(255)

  classSubjects ClassSubject[]

  @@map("subjects")
}

model ClassSubject {
  id           String @id @default(uuid()) @db.Uuid
  classId      String @map("class_id") @db.Uuid
  subjectId    String @map("subject_id") @db.Uuid
  teacherId    String? @map("teacher_id") @db.Uuid
  semester     Int
  academicYear Int    @map("academic_year")

  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  materials  Material[]
  progress   StudentProgress[]
  quizSessions QuizSession[]
  weeklyReports WeeklyReport[]

  @@unique([classId, subjectId, semester, academicYear])
  @@map("class_subjects")
}

model Material {
  id             String  @id @default(uuid()) @db.Uuid
  classSubjectId String  @map("class_subject_id") @db.Uuid
  title          String  @db.VarChar(255)
  contentText    String? @map("content_text") @db.Text
  orderIndex     Int     @map("order_index")
  difficulty     String  @default("MEDIUM") @db.VarChar(20)
  isPublished    Boolean @default(false) @map("is_published")

  classSubject  ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  videos        Video[]
  questions     Question[]
  quizSessions  QuizSession[]

  @@map("materials")
}

model Video {
  id              String  @id @default(uuid()) @db.Uuid
  materialId      String  @map("material_id") @db.Uuid
  title           String  @db.VarChar(255)
  embedUrl        String  @map("embed_url") @db.VarChar(255)
  durationSeconds Int     @map("duration_seconds")
  pointReward     Int     @default(0) @map("point_reward")

  material    Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  videoWatches VideoWatch[]

  @@map("videos")
}

model Question {
  id            String @id @default(uuid()) @db.Uuid
  materialId    String @map("material_id") @db.Uuid
  questionText  String @map("question_text") @db.Text
  options       Json   @db.JsonB
  correctAnswer String @map("correct_answer") @db.VarChar(255)
  difficulty    String @default("MEDIUM") @db.VarChar(20)
  pointReward   Int    @default(0) @map("point_reward")
  orderIndex    Int    @map("order_index")

  material    Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]

  @@map("questions")
}

model StudentProgress {
  id                String   @id @default(uuid()) @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  classSubjectId    String   @map("class_subject_id") @db.Uuid
  completionPercent Float    @default(0.0) @map("completion_percent")
  totalScore        Int      @default(0) @map("total_score")
  adaptiveLevel     String   @default("STANDARD") @map("adaptive_level") @db.VarChar(20)
  lastActivity      DateTime @default(now()) @map("last_activity") @db.Timestamptz

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])

  @@unique([studentId, classSubjectId])
  @@map("student_progress")
}

model QuizSession {
  id             String    @id @default(uuid()) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  classSubjectId String    @map("class_subject_id") @db.Uuid
  materialId     String    @map("material_id") @db.Uuid
  score          Int       @default(0)
  correctCount   Int       @default(0) @map("correct_count")
  wrongCount     Int       @default(0) @map("wrong_count")
  livesUsed      Int       @default(0) @map("lives_used")
  streakCount    Int       @default(0) @map("streak_count")
  currentLevel   String    @default("MEDIUM") @map("current_level") @db.VarChar(20)
  resultLevel    String?   @map("result_level") @db.VarChar(20)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])
  material     Material     @relation(fields: [materialId], references: [id])
  answers      QuizAnswer[]

  @@map("quiz_sessions")
}

model QuizAnswer {
  id           String  @id @default(uuid()) @db.Uuid
  sessionId    String  @map("session_id") @db.Uuid
  questionId   String  @map("question_id") @db.Uuid
  answerGiven  String  @map("answer_given") @db.VarChar(255)
  isCorrect    Boolean @map("is_correct")
  timeTakenSec Int?    @map("time_taken_sec")

  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@map("quiz_answers")
}

model VideoWatch {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  videoId        String   @map("video_id") @db.Uuid
  watchedSeconds Int      @default(0) @map("watched_seconds")
  isCompleted    Boolean  @default(false) @map("is_completed")
  watchedAt      DateTime @default(now()) @map("watched_at") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video   Video   @relation(fields: [videoId], references: [id])

  @@map("video_watches")
}

model PointLog {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  pointsEarned Int     @map("points_earned")
  sourceType  String   @map("source_type") @db.VarChar(20)
  sourceId    String?  @map("source_id") @db.Uuid
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("point_logs")
}

model WeeklyReport {
  id               String   @id @default(uuid()) @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  classSubjectId   String   @map("class_subject_id") @db.Uuid
  teacherId        String?  @map("teacher_id") @db.Uuid
  weekStart        DateTime @map("week_start") @db.Date
  avgScore         Int      @default(0) @map("avg_score")
  completionRate   Float    @default(0.0) @map("completion_rate")
  recommendation   String?  @db.Text
  kkmAchieved      Boolean  @default(false) @map("kkm_achieved")
  generatedAt      DateTime @default(now()) @map("generated_at") @db.Timestamptz

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])
  teacher      Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@map("weekly_reports")
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  content    String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz

  sender   User @relation("SentMessage", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessage", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(150)
  body      String   @db.Text
  notifType String   @map("notif_type") @db.VarChar(20)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
